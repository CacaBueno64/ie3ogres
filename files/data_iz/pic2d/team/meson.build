subdir('gmdn_s')
subdir('mgu_td')
subdir('mgu_tu')
subdir('pkup_e')
subdir('pkup_t')
subdir('po_e')
subdir('po_n')
subdir('po_s')
subdir('po_t')
subdir('po_w')

gmdn_s_pack = custom_target('gmdn_s_pack',
    output: [
        'gmdn_s.pkb',
        'gmdn_s.pkh',
    ],
    input: gmdn_s_pac_files_comp,
    command: [
        archive_py,
        '-t', 'PKB',
        '-c',
        '@INPUT0@',
        '@OUTDIR@',
    ],
)

nitrofs_files += gmdn_s_pack

