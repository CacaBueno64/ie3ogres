pkup_e_pac_files = []

foreach pkup_e_png : pkup_e_png_files
    pac = custom_target(fs.name(pkup_e_png).replace('.png', '.pac'),
        input: pkup_e_png,
        output: '@BASENAME@.pac',
        command: [
            image_exe,
            '-c',
            '@INPUT@',
            '@OUTPUT@',
            '--type', 'PSC',
        ]
    )
    pkup_e_pac_files += pac
endforeach

pkup_e_pac_files_comp = []

foreach pkup_e_pac : pkup_e_pac_files
    comp = custom_target(fs.name(pkup_e_pac).replace('.pac', '.pac_'),
        input: pkup_e_pac,
        output: '@PLAINNAME@' + '_',
        command: [
            compression_exe,
            '-c',
            '@INPUT@',
            '@OUTPUT@',
        ]
    )
    pkup_e_pac_files_comp += comp
endforeach
