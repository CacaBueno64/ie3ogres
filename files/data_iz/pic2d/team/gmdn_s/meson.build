gmdn_s_pac_files = []

foreach gmdn_s_png : gmdn_s_png_files
    pac = custom_target(fs.name(gmdn_s_png).replace('.png', '.pac'),
        input: gmdn_s_png,
        output: '@BASENAME@.pac',
        command: [
            image_exe,
            '-c',
            '@INPUT@',
            '@OUTPUT@',
            '--type', 'PSC',
        ]
    )
    gmdn_s_pac_files += pac
endforeach

gmdn_s_pac_files_comp = []

foreach gmdn_s_pac : gmdn_s_pac_files
    comp = custom_target(fs.name(gmdn_s_pac).replace('.pac', '.pac_'),
        input: gmdn_s_pac,
        output: '@PLAINNAME@' + '_',
        command: [
            compression_exe,
            '-c',
            '@INPUT@',
            '@OUTPUT@',
        ]
    )
    gmdn_s_pac_files_comp += comp
endforeach
