mgu_tu_pac_files = []

foreach mgu_tu_png : mgu_tu_png_files
    pac = custom_target(fs.name(mgu_tu_png).replace('.png', '.pac'),
        input: mgu_tu_png,
        output: '@BASENAME@.pac',
        command: [
            image_exe,
            '-c',
            '@INPUT@',
            '@OUTPUT@',
            '--type', 'PSC',
        ]
    )
    mgu_tu_pac_files += pac
endforeach

mgu_tu_pac_files_comp = []

foreach mgu_tu_pac : mgu_tu_pac_files
    comp = custom_target(fs.name(mgu_tu_pac).replace('.pac', '.pac_'),
        input: mgu_tu_pac,
        output: '@PLAINNAME@' + '_',
        command: [
            compression_exe,
            '-c',
            '@INPUT@',
            '@OUTPUT@',
        ]
    )
    mgu_tu_pac_files_comp += comp
endforeach
