po_n_pac_files = []

foreach po_n_png : po_n_png_files
    pac = custom_target(fs.name(po_n_png).replace('.png', '.pac'),
        input: po_n_png,
        output: '@BASENAME@.pac',
        command: [
            image_exe,
            '-c',
            '@INPUT@',
            '@OUTPUT@',
            '--type', 'PSC',
            '--opt', 'true',
        ]
    )
    po_n_pac_files += pac
endforeach

po_n_pac_files_comp = []

foreach po_n_pac : po_n_pac_files
    comp = custom_target(fs.name(po_n_pac).replace('.pac', '.pac_'),
        input: po_n_pac,
        output: '@PLAINNAME@' + '_',
        command: [
            compression_exe,
            '-c',
            '@INPUT@',
            '@OUTPUT@',
        ]
    )
    po_n_pac_files_comp += comp
endforeach
