po_t_pac_files = []

foreach po_t_png : po_t_png_files
    pac = custom_target(fs.name(po_t_png).replace('.png', '.pac'),
        input: po_t_png,
        output: '@BASENAME@.pac',
        command: [
            image_exe,
            '-c',
            '@INPUT@',
            '@OUTPUT@',
            '--type', 'PSC',
            '--opt', 'true',
        ]
    )
    po_t_pac_files += pac
endforeach

po_t_pac_files_comp = []

foreach po_t_pac : po_t_pac_files
    comp = custom_target(fs.name(po_t_pac).replace('.pac', '.pac_'),
        input: po_t_pac,
        output: '@PLAINNAME@' + '_',
        command: [
            compression_exe,
            '-c',
            '@INPUT@',
            '@OUTPUT@',
        ]
    )
    po_t_pac_files_comp += comp
endforeach
