mgu_td_pac_files = []

foreach mgu_td_png : mgu_td_png_files
    pac = custom_target(fs.name(mgu_td_png).replace('.png', '.pac'),
        input: mgu_td_png,
        output: '@BASENAME@.pac',
        command: [
            image_exe,
            '-c',
            '@INPUT@',
            '@OUTPUT@',
            '--type', 'PSC',
        ]
    )
    mgu_td_pac_files += pac
endforeach

mgu_td_pac_files_comp = []

foreach mgu_td_pac : mgu_td_pac_files
    comp = custom_target(fs.name(mgu_td_pac).replace('.pac', '.pac_'),
        input: mgu_td_pac,
        output: '@PLAINNAME@' + '_',
        command: [
            compression_exe,
            '-c',
            '@INPUT@',
            '@OUTPUT@',
        ]
    )
    mgu_td_pac_files_comp += comp
endforeach
