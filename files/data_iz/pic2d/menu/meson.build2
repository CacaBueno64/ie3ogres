pic2d_menu_png_files = files(
    '_mbdn_bg00.png',
    'jmup_bg00.png',
    'klup_bg00.png',
    'msup_bg00.png',
    'msup_bg01.png',
    'msup_bg02.png',
    'msup_bg04.png',
    'msup_bg05.png',
    'msup_bg07.png',
    'msup_bg08.png',
    'msup_bg09.png',
    'msup_f12.png',
    'mvup_bg1.png',
    'mvup_w01.png',
    'nedn_bg00.png',
    'nedn_bg04.png',
    'nedn_bg05.png',
    'nedn_bg08.png',
    'nedn_bg10.png',
    'prdn_bg00.png',
    'pwup_bg00.png',
    'scdn_bg00.png',
    'scdn_bg01.png',
    'sfdn_i09.png',
    'wdup_bg00.png',
)

pic2d_menu_pac_files = []

python3 = find_program('python3')

foreach pic2d_menu_png : pic2d_menu_png_files
    pac = custom_target(fs.name(pic2d_menu_png).replace('.png', '.pac'),
        input: pic2d_menu_png,
        output: '@BASENAME@.pac',
        command: [
            python3,
            image_py,
            '@INPUT@',
            '-t', 'PSC',
            '-c', '@OUTPUT@',
        ]
    )
    pic2d_menu_pac_files += pac
endforeach

pic2d_menu_comp_files = []

foreach pic2d_menu_pac : pic2d_menu_pac_files
    comp = custom_target(fs.name(pic2d_menu_pac).replace('.pac', '.pac_'),
        input: pic2d_menu_pac,
        output: '@BASENAME@.pac_',
        command: [
            compress_exe,
            '-t', 'LZ',
            '-c', '@INPUT@', '@OUTPUT@',
        ]
    )

    pic2d_menu_comp_files += comp
endforeach

nitrofs_files += pic2d_menu_comp_files

prebuilt_files = [
    'menu_MovieViewSub.pkb',
    'menu_MovieViewSub.pkh',
    'mvdn_e.pkb',
    'mvdn_e.pkh',
    'mvdn_q.pkb',
    'mvdn_q.pkh',
]

foreach f : prebuilt_files
    nitrofs_files += fs.copyfile(f)
endforeach
