MASConfig_pack = custom_target('MASConfig_pack',
    output: 'MASConfig.SPF_',
    command: [
        archive_exe,
        '-t', 'SPF',
        '-c', '@OUTDIR@/MASConfig',
        '@OUTDIR@',
        MASConfig_files,
    ],
    depends: MASConfig_files
)

nitrofs_files += MASConfig_pack

