fac_pac_files = []

python3 = find_program('python3')

foreach fac_png : fac_png_files
    pac = custom_target(fs.name(fac_png).replace('.png', '.pac_'),
        input: fac_png,
        output: '@BASENAME@.pac_',
        command: [
            python3,
            image_py,
            '@INPUT@',
            '-t', 'PSCM',
            '-c', '@OUTPUT@',
        ]
    )
    fac_pac_files += pac
endforeach
